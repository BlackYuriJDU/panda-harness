      "outputs": ["memory/audit/gwas-loci.md"],
      "write_scope": ["memory/audit/"],
      "depends_on": [],
      "acceptance": ["Every locus cites source_path:source_line", "No claim without evidence_id"],
      "status": "pending"
    },
    {
      "task_id": "t_number-check",
      "role": "number-verifier",
      "objective": "Recompute the reported effect sizes and compare them to the published numbers.",
      "inputs": ["corpus/studies/dcj-gwas.md", "pipeline/reports/"],
      "outputs": ["memory/audit/gwas-numbers.md"],
