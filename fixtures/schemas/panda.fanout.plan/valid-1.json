{
  "schema": "panda.fanout.plan.v1",
  "plan_id": "fo_gwas-followup-001",
  "created_at": "2026-10-25T12:00:00.000Z",
  "objective": "Verify the three published GWAS loci against the independent QC report without crossing write scopes.",
  "max_parallel": 3,
  "tasks": [
    {
