      "acceptance": ["Every number cites evidence_id", "Mismatches are listed explicitly"],
      "status": "pending"
    }
  ],
  "merge": {
    "strategy": "union",
    "verifier": "control-evidence-ledger",
    "conflict_policy": "fail"
