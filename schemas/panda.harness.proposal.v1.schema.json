{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panda-harness.dev/schemas/panda.harness.proposal.v1.schema.json",
  "title": "Panda harness proposal v1",
  "description": "A self-improvement proposal with evidence, a diff, a verification plan, and approvals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_id",
    "created_at",
    "title",
    "rationale",
    "evidence",
    "change",
    "expected_effect",
    "verification",
    "status",
    "approvals"
  ],
  "properties": {
    "schema": { "const": "panda.harness.proposal.v1" },
    "proposal_id": { "type": "string", "pattern": "^hp_[a-z0-9][a-z0-9-]{5,63}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "title": { "type": "string", "minLength": 8, "maxLength": 160 },
    "rationale": { "type": "string", "minLength": 20, "maxLength": 8000 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "summary"],
        "properties": {
          "kind": { "enum": ["file", "command", "url", "test", "incident", "review"] },
          "ref": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 8 }
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "diff", "risk", "rollback"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "diff": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "rollback": { "type": "string", "minLength": 8 }
      }
    },
    "expected_effect": { "type": "string", "minLength": 20 },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "expected"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected": { "type": "string", "minLength": 8 }
      }
    },
    "status": { "enum": ["proposed", "approved", "rejected", "applied", "reverted"] },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor", "at", "decision", "note"],
        "properties": {
          "actor": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "format": "date-time" },
          "decision": { "enum": ["approved", "rejected"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}
