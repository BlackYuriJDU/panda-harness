{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panda-harness.dev/schemas/panda.metric.v1.schema.json",
  "title": "Panda run metric v1",
  "description": "Cost, token, cache, context, and tool usage for one run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "session_id",
    "model",
    "status",
    "started_at",
    "ended_at",
    "duration_ms",
    "usage",
    "context",
    "tools",
    "cost_usd"
  ],
  "properties": {
    "schema": { "const": "panda.metric.v1" },
    "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9_-]{6,80}$" },
    "session_id": { "type": "string", "pattern": "^s_[A-Za-z0-9_]{6,80}$" },
    "model": { "type": "string", "minLength": 3 },
    "provider": { "type": ["string", "null"] },
    "status": { "enum": ["success", "error", "cancelled", "timeout"] },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "usage": { "$ref": "#/$defs/usage" },
    "context": { "$ref": "#/$defs/context" },
    "tools": { "$ref": "#/$defs/tools" },
    "cost_usd": { "type": "number", "minimum": 0 },
    "cache_hit_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "steps": { "type": ["integer", "null"], "minimum": 0 }
  },
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "reasoning_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_read_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_write_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_tokens", "used_tokens", "used_pct"],
      "properties": {
        "window_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "used_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "used_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "failures"],
      "properties": {
        "calls": { "type": "integer", "minimum": 0 },
        "failures": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
